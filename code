// =====================================================================
// 9. ULTRASONIC & SENSOR HELPER FUNCTIONS
// =====================================================================
long measureDistance(int trigPin, int echoPin) {
  digitalWrite(trigPin, LOW);
  delayMicroseconds(2);
  digitalWrite(trigPin, HIGH);
  delayMicroseconds(10);
  digitalWrite(trigPin, LOW);

  long duration = pulseIn(echoPin, HIGH, 30000);
  if (duration == 0) return 999; 
  return (duration * 0.034 / 2);
}

void checkObstaclesAndAlert() {
  long frontDistCm = measureDistance(FRONT_TRIG_PIN, FRONT_ECHO_PIN);
  long backDistCm  = measureDistance(BACK_TRIG_PIN, BACK_ECHO_PIN);

  if (frontDistCm <= OBSTACLE_THRESHOLD_CM || backDistCm <= OBSTACLE_THRESHOLD_CM) {
    digitalWrite(BUZZER_PIN, HIGH);
  } else {
    digitalWrite(BUZZER_PIN, LOW);
  }
}

// =====================================================================
// 10. MOTOR & SERVO CONTROL FUNCTIONS
// =====================================================================
int speedPercentToPwm(int speedPercent) {
  speedPercent = constrain(speedPercent, MIN_SPEED_PERCENT, MAX_SPEED_PERCENT);
  int minimumUsablePwm = (MOTOR_PWM_MAX * MIN_USABLE_MOTOR_PWM_PERCENT) / 100;
  return map(speedPercent, 0, 100, minimumUsablePwm, MOTOR_PWM_MAX);
}

void applyDriveMotors(DriveCommand cmd, int pwm) {
  switch (cmd) {
    case DRIVE_FORWARD:
      digitalWrite(RIGHT_MOTOR_IN1, HIGH); digitalWrite(RIGHT_MOTOR_IN2, LOW);
      digitalWrite(LEFT_MOTOR_IN1, HIGH);  digitalWrite(LEFT_MOTOR_IN2, LOW);
      ledcWrite(RIGHT_MOTOR_EN, pwm);
      ledcWrite(LEFT_MOTOR_EN, pwm);
      break;
    case DRIVE_REVERSE:
      digitalWrite(RIGHT_MOTOR_IN1, LOW);  digitalWrite(RIGHT_MOTOR_IN2, HIGH);
      digitalWrite(LEFT_MOTOR_IN1, LOW);  digitalWrite(LEFT_MOTOR_IN2, HIGH);
      ledcWrite(RIGHT_MOTOR_EN, pwm);
      ledcWrite(LEFT_MOTOR_EN, pwm);
      break;
    case DRIVE_ROTATE_LEFT:
      digitalWrite(RIGHT_MOTOR_IN1, HIGH); digitalWrite(RIGHT_MOTOR_IN2, LOW);
      digitalWrite(LEFT_MOTOR_IN1, LOW);  digitalWrite(LEFT_MOTOR_IN2, HIGH);
      ledcWrite(RIGHT_MOTOR_EN, pwm);
      ledcWrite(LEFT_MOTOR_EN, pwm);
      break;
    case DRIVE_ROTATE_RIGHT:
      digitalWrite(RIGHT_MOTOR_IN1, LOW);  digitalWrite(RIGHT_MOTOR_IN2, HIGH);
      digitalWrite(LEFT_MOTOR_IN1, HIGH);  digitalWrite(LEFT_MOTOR_IN2, LOW);
      ledcWrite(RIGHT_MOTOR_EN, pwm);
      ledcWrite(LEFT_MOTOR_EN, pwm);
      break;
    case DRIVE_STOPPED:
    default:
      digitalWrite(RIGHT_MOTOR_IN1, LOW); digitalWrite(RIGHT_MOTOR_IN2, LOW);
      digitalWrite(LEFT_MOTOR_IN1, LOW);  digitalWrite(LEFT_MOTOR_IN2, LOW);
      ledcWrite(RIGHT_MOTOR_EN, 0);
      ledcWrite(LEFT_MOTOR_EN, 0);
      break;
  }
}

void updateSteeringServos() {
  int frontDuty = map(currentFrontAngle, 0, 180, 500, 2500);
  int rearDuty  = map(currentRearAngle, 0, 180, 500, 2500);
  
  int frontDutyCycle = map(frontDuty, 0, 20000, 0, 65535);
  int rearDutyCycle  = map(rearDuty, 0, 20000, 0, 65535);

  ledcWrite(FRONT_SERVO_PIN, frontDutyCycle);
  ledcWrite(REAR_SERVO_PIN, rearDutyCycle);
}

// =====================================================================
// 11. SETUP & LOOP
// =====================================================================
void setup() {
  Serial.begin(115200);

  pinMode(RIGHT_MOTOR_IN1, OUTPUT);
  pinMode(RIGHT_MOTOR_IN2, OUTPUT);
  pinMode(LEFT_MOTOR_IN1, OUTPUT);
  pinMode(LEFT_MOTOR_IN2, OUTPUT);

  pinMode(FRONT_TRIG_PIN, OUTPUT);
  pinMode(FRONT_ECHO_PIN, INPUT);
  pinMode(BACK_TRIG_PIN, OUTPUT);
  pinMode(BACK_ECHO_PIN, INPUT);
  pinMode(BUZZER_PIN, OUTPUT);
  digitalWrite(BUZZER_PIN, LOW);

  ledcAttach(RIGHT_MOTOR_EN, MOTOR_PWM_FREQUENCY, MOTOR_PWM_RESOLUTION);
  ledcAttach(LEFT_MOTOR_EN, MOTOR_PWM_FREQUENCY, MOTOR_PWM_RESOLUTION);

  ledcAttach(FRONT_SERVO_PIN, 50, 16);
  ledcAttach(REAR_SERVO_PIN, 50, 16);

  WiFi.softAP(AP_SSID, AP_PASSWORD);
  WiFi.softAPConfig(IPAddress(192, 168, 4, 1), IPAddress(192, 168, 4, 1), IPAddress(255, 255, 255, 0));

  server.on("/", HTTP_GET, []() {
    server.send_P(200, "text/html", INDEX_HTML);
  });

  server.on("/drive", HTTP_GET, []() {
    String cmd = server.arg("cmd");
    if (cmd == "forward") currentDriveCommand = DRIVE_FORWARD;
    else if (cmd == "reverse") currentDriveCommand = DRIVE_REVERSE;
    else if (cmd == "left") currentDriveCommand = DRIVE_ROTATE_LEFT;
    else if (cmd == "right") currentDriveCommand = DRIVE_ROTATE_RIGHT;
    else currentDriveCommand = DRIVE_STOPPED;

    motorPwmValue = speedPercentToPwm(motorSpeedPercent);
    applyDriveMotors(currentDriveCommand, motorPwmValue);
    lastDriveCommandTime = millis();
    server.send(200, "text/plain", "OK");
  });

  server.on("/steer", HTTP_GET, []() {
    String dir = server.arg("dir");
    if (dir == "left") {
      currentFrontAngle = FRONT_LEFT;
      currentRearAngle = REAR_RIGHT;
    } else if (dir == "right") {
      currentFrontAngle = FRONT_RIGHT;
      currentRearAngle = REAR_LEFT;
    } else {
      currentFrontAngle = FRONT_CENTER;
      currentRearAngle = REAR_CENTER;
    }
    updateSteeringServos();
    server.send(200, "text/plain", "OK");
  });

  server.on("/speed", HTTP_GET, []() {
    motorSpeedPercent = server.arg("value").toInt();
    server.send(200, "text/plain", "OK");
  });

  server.on("/emergency", HTTP_GET, []() {
    currentDriveCommand = DRIVE_STOPPED;
    applyDriveMotors(DRIVE_STOPPED, 0);
    currentFrontAngle = FRONT_CENTER;
    currentRearAngle = REAR_CENTER;
    updateSteeringServos();
    server.send(200, "text/plain", "OK");
  });

  server.begin();
}

void loop() {
  server.handleClient();

  if (millis() - lastDriveCommandTime > DRIVE_SAFETY_TIMEOUT_MS) {
    currentDriveCommand = DRIVE_STOPPED;
    applyDriveMotors(DRIVE_STOPPED, 0);
  }

  checkObstaclesAndAlert();
}
