const int FRONT_CENTER = 95;
const int FRONT_RIGHT  = 125;

const int REAR_LEFT   = 100;
const int REAR_CENTER = 80;
const int REAR_RIGHT  = 50;

// =====================================================================
// 5. PWM SETTINGS
// =====================================================================
const int MOTOR_PWM_FREQUENCY  = 15000;
const int MOTOR_PWM_RESOLUTION = 8;
const int MOTOR_PWM_MAX        = 255;

const int MIN_SPEED_PERCENT     = 0;
const int MAX_SPEED_PERCENT     = 100;
const int DEFAULT_SPEED_PERCENT = 50;
const int MIN_USABLE_MOTOR_PWM_PERCENT = 70;

const unsigned long DRIVE_SAFETY_TIMEOUT_MS = 650;

// =====================================================================
// 6. DRIVE STATE
// =====================================================================
enum DriveCommand {
  DRIVE_STOPPED,
  DRIVE_FORWARD,
  DRIVE_REVERSE,
  DRIVE_ROTATE_LEFT,
  DRIVE_ROTATE_RIGHT
};

DriveCommand currentDriveCommand = DRIVE_STOPPED;
int motorSpeedPercent = DEFAULT_SPEED_PERCENT;
int motorPwmValue = 0;
unsigned long lastDriveCommandTime = 0;

int currentFrontAngle = FRONT_CENTER;
int currentRearAngle  = REAR_CENTER;

// =====================================================================
// 7. WI-FI SETTINGS
// =====================================================================
const char* AP_SSID     = "MrPotato2425";
const char* AP_PASSWORD = "7772425";

WebServer server(80);

