// =====================================================================
// 1. MOTOR PIN DEFINITIONS
// =====================================================================
const int RIGHT_MOTOR_EN  = 23;  // ENA
const int RIGHT_MOTOR_IN1 = 22;  // IN1
const int RIGHT_MOTOR_IN2 = 21;  // IN2

const int LEFT_MOTOR_EN  = 16;   // ENB
const int LEFT_MOTOR_IN1 = 17;   // IN3
const int LEFT_MOTOR_IN2 = 5;    // IN4

// =====================================================================
// 2. SERVO PIN DEFINITIONS
// =====================================================================
